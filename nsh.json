{
  "name": "Downloader",
  "id": "dev.nsh.downloader",
  "version": "1.2.0",
  "build": 1,
  "updater": {
    "github": "aafnnp/nsh-downloader"
  },
  "icon": "icon.png",
  "appearance": "system",
  "theme": "theme.json",
  "singleInstance": true,
  "fileTypes": [
    {
      "name": "BitTorrent",
      "extensions": [
        "torrent"
      ],
      "mimeTypes": [
        "application/x-bittorrent"
      ],
      "role": "viewer"
    }
  ],
  "capabilities": {
    "application": true,
    "network": {
      "hosts": [
        "*"
      ]
    },
    "clipboard": true,
    "openUrl": {
      "schemes": [
        "https"
      ]
    },
    "process": {
      "execute": [
        "curl",
        "aria2c",
        "sh",
        "cmd",
        "cmd.exe",
        "powershell.exe",
        "tar",
        "chmod",
        "open",
        "explorer.exe",
        "xdg-open"
      ],
      "exit": false,
      "env": [
        "NSH_DEV_APP_DIR"
      ]
    },
    "fs": {
      "read": [
        "${pluginDir}",
        "${dataDir}",
        "${homeDir}"
      ],
      "write": [
        "${dataDir}",
        "${homeDir}"
      ]
    },
    "statusBar": true
  }
}
